	file = {PDF:C\:\\Users\\ziada\\Zotero\\storage\\4CLTMDKE\\Ahsan and Pathan - 2025 - A Comprehensive Survey on the Requirements, Applications, and Future Challenges for Access Control M.pdf:application/pdf},
}

